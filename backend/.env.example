# Sequence Platform backend - environment configuration (example).
#
# Copy to `.env` and fill in real values. Never commit a filled-in `.env`
# file or any real credentials, API keys, tokens, or secrets.

# NCBI (Entrez). NCBI requires an email to be set on requests. Without an
# API key the client-side throttle is 3 requests/second; with a key it is
# 10 requests/second. Both values are optional and the application runs
# with no key at all.
NCBI_EMAIL=
NCBI_API_KEY=
